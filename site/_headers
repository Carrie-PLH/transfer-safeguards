# Cache policy. Hand-written; generate-sitemap.py does not touch this file.
#
# The stylesheet and the icons are not content-hashed, so a long max-age would
# strand a repeat visitor on a stale copy after a deploy. These values are the
# staleness each file can carry:
#
#   style.css   one day. It changes when the shared mobile layer changes,
#               which is rare, and a day is the longest a reader should be
#               shown last week's layout.
#   icons, art  thirty days. A favicon or wordmark that changes gets a new
#               name, or waits.
#
# Everything not listed keeps the default (max-age=0, must-revalidate), which
# is what an HTML page should have: the pages carry dated quotations, and a
# reader must never be served yesterday's text from their own cache.

/assets/*.css
  Cache-Control: public, max-age=86400

/assets/*.svg
  Cache-Control: public, max-age=2592000

/assets/*.png
  Cache-Control: public, max-age=2592000

/assets/*.ico
  Cache-Control: public, max-age=2592000

# RFC 9116 requires security.txt to be served as text/plain with the charset
# parameter set to utf-8. Workers static assets send bare text/plain for .txt
# (Pages adds the charset itself), so it is set here. Added 2026-09-11.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Response headers every page carries. Added 2026-09-11. None of these
# changes what the site does; each closes a class of scanner finding at no
# cost. nosniff stops a browser second-guessing a content type. DENY stops
# the pages being framed inside someone else's site. The referrer policy
# sends only the origin to other sites a reader follows a link to. The
# permissions policy turns off browser features no page here uses. A
# Content-Security-Policy is deliberately not here: it needs per-site
# testing and a report-only period first, and is its own decision.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
